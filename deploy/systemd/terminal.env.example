# haro 终端（haro）的配置样例。复制成 ~/.config/haro/haro.env 再按自己的机器改：
# systemd 单元 haro.service、安装脚本装的开机自启都从这个文件读。
# 每行 KEY="value"（由 sh 读取，启动时自动导出），# 开头的是注释。
# 一般只要改 HARO_SERVER_URL；注释掉的写的是默认值（不写就是这个值），要改时去掉行首的 #。
# 每一项的说明以 internal/config/config.go 的 TerminalSettings 为准。
# 终端和服务端在同一台机器上、共用一个文件时，服务端的项见 deploy/server/server.env.example（两边各读各的）。

# ---- 服务端 ----
# haro-server 的地址：http(s)://主机[:端口]（对话走 WebSocket、登记声纹走 HTTP，都按它连）
HARO_SERVER_URL="http://127.0.0.1:59130"
# 设备凭证（haro -pair 配对后存下的）放在哪；空 = ~/.config/haro/device-credential。没有这个文件 = 没配对（现在照旧能连）
#HARO_DEVICE_CREDENTIAL_FILE=""

# ---- 说完判断与 VAD（每次打开识别流时交给 haro-asr）----
# semantic_vad：Smart Turn 判断语气（haro-asr 要配了 HARO_TURN_MODEL）；server_vad：只等静音 HARO_VAD_SILENCE
#HARO_TURN_DETECTION="semantic_vad"
# semantic_vad 判定还没说完以后，最长再等多久：low / auto / high
#HARO_TURN_EAGERNESS="auto"
# 语音概率门槛（0–1）；不设 = haro-asr 的默认值（asrserver.Timing.VADThreshold）
#HARO_VAD_THRESHOLD=""
# server_vad：静音持续多久算说完；不设 = haro-asr 的默认值（asrserver.Timing.VADSilence）
#HARO_VAD_SILENCE=""
# 识别时带上语音开始前的这一段
#HARO_VAD_PREFIX="300ms"
# 播完后再静音这么久才恢复收音（防止音箱的余音被当成一句话）
#HARO_ECHO_GUARD="300ms"

# ---- 唤醒词（唯一的对话方式；唤醒词本身在 haro-asr 的关键词文件里，终端从服务端拿）----
# 对话窗口：回答播完后安静这么久就休眠（休眠时说一声）
#HARO_WAKE_IDLE="40s"
# 回答时怎么打断：voice = 一开口就停（要麦克风有回声消除，见 deploy/pipewire/）/ wake = 喊唤醒词才停 / off = 不能打断
#HARO_BARGE_IN="wake"

# ---- 设备：默认全部自动检测，只在要手动指定时才设（值是各系统自己的设备 ID）----
# 麦克风：空 = 跟系统默认，但跳过蓝牙麦克风。麦克风的 ID 见启动日志 🎤 那一行的 id；填的设备不在时终端待机
#HARO_AUDIO_SOURCE=""
# 音箱：空 = 跟系统默认（蓝牙重连后自动接回）
#HARO_AUDIO_SINK=""
# 摄像头：空 = 自动找；none = 不用摄像头
#HARO_CAMERA_DEVICE=""
# 拍照用哪套底层：auto / mediadevices（目前只有 Linux）/ ffmpeg（macOS 上要装 ffmpeg）
#HARO_CAMERA_BACKEND="auto"
# 想向摄像头要的分辨率（宽x高）；摄像头没有时改要宽度够的里面最小的
#HARO_CAMERA_SIZE="1280x720"
# 送给模型的画面最大宽度：更宽就缩小，更窄原样送
#HARO_FRAME_WIDTH="1280"
# 自己录的提示音所在的目录：offline.wav、online.wav、sleep.wav、notice.wav、reminder.wav（16 bit PCM，缺哪个就用内置的那个）；
# 空 = 内置的不含人声的提示音；设了就必须是读得到的目录（读不到时终端起不来）
#HARO_TONES_DIR=""

# ---- 时区 ----
# 日志里的时间按进程的本地时区：标准的环境变量 TZ，不设 = 系统的时区（「今天」、费用上限这些按服务端的时区算，和这里无关）。
# 启动日志的「时区」那一行写着实际用的时区

# ---- 观测 ----
# OTLP/HTTP 的根地址（例如 http://127.0.0.1:4318）；空 = 不导出，只打日志。
# 也认标准的 OTEL_EXPORTER_OTLP_ENDPOINT（设了时以它为准）、OTEL_SERVICE_NAME、OTEL_RESOURCE_ATTRIBUTES（只支持 http/protobuf）
#HARO_OTLP_ENDPOINT=""
