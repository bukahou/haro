# haro 服务端（haro-server）的配置样例。复制一份再按自己的环境改：开发机上是 ~/.config/haro/haro.env
# （systemd 单元 haro-server.service 从那里读，相对路径从仓库根目录算）；集群里由 ConfigMap / Secret 给。
# 每行 KEY="value"（由 sh / bash 读取，启动时自动导出），# 开头的是注释。
# 没注释掉的是按默认配置运行时的必填项，值都是占位，要换成自己的；注释掉的写的是默认值（不写就是这个值）。
# 每一项的说明以 internal/config/config.go 的 ServerSettings 为准（这里只列常用的）；
# 语音识别 haro-asr 的配置见 internal/config/asr.go 的 ASRSettings；终端的见 deploy/systemd/terminal.env.example。
# ⚠️ 凭证（API key）只放在这个文件或 Secret 里，不要提交进 git。

# ---- 监听 ----
# 只监听本机；终端在别的机器上时改成那台机器连得到的地址（只在可信网络里）
#HARO_SERVER_LISTEN="127.0.0.1:59130"

# ---- 时区 ----
# 「今天」「这个月」（每日、每月的费用上限什么时候翻篇）、告诉模型的现在时间、记事显示的时间都按进程的本地时区算
# （存储一律是 UTC）。时区用标准的环境变量 TZ：不设 = 系统的时区（容器里一般是 UTC，差几个小时也不报错）。
# 程序里带着时区数据，镜像里不装 tzdata 也认。启动日志的「时区」那一行写着实际用的时区。要改就加一行，例如：
#   TZ="Asia/Tokyo"

# ---- 语音识别：haro-asr 单独运行，服务端只认它的地址 ----
HARO_ASR_URL="http://127.0.0.1:59126"

# ---- 语音合成：服务单独运行，服务端只认地址 ----
# 引擎：gpt-sovits（按情绪选参考录音，流式）/ piper（开发用：不支持情绪、只会中文）
#HARO_TTS="gpt-sovits"
HARO_TTS_URL="http://127.0.0.1:9880"
# gpt-sovits：参考录音在合成服务那台机器上的目录；声音档案（各情绪的参考录音名与文字，格式见 assets/voices/example.json）
HARO_TTS_REF_DIR="/path/to/reference-audio"
HARO_TTS_VOICE_FILE="/path/to/voice.json"
# gpt-sovits 的流式档位（0–3）
#HARO_TTS_STREAMING_MODE="2"
# 单句合成（含边收边播）的超时
#HARO_TTS_TIMEOUT="30s"

# ---- 模型 ----
# 用哪个模型：cloud（云端）/ local（本机 ollama）。两者不自动互相顶替：云端连不上时只念「连不上」和现在的时间
#HARO_LLM_PROVIDER="cloud"
# 云端的接口格式：anthropic（Claude API）/ openai（OpenAI 兼容）
#HARO_CLOUD_LLM_API="anthropic"
# 云端的模型 ID
HARO_CLOUD_LLM_MODEL="claude-haiku-5-5"
# anthropic 的凭证：开发机填 key；集群里留空，由 SDK 走 Workload Identity Federation（ANTHROPIC_FEDERATION_* 等）
HARO_ANTHROPIC_API_KEY=""
# openai：接口的根地址（…/v1）和凭证
#HARO_CLOUD_LLM_URL=""
#HARO_CLOUD_LLM_API_KEY=""
# anthropic 的回答力度（low / medium / high；思考写法是 adaptive 时还可以 xhigh / max）、思考写法（disabled / between_tools / adaptive）
#HARO_CLOUD_LLM_EFFORT="low"
#HARO_CLOUD_LLM_THINKING="disabled"
# anthropic：对话的提示词缓存留多久（5m / 1h）
#HARO_CLOUD_LLM_CACHE_TTL="1h"
# 等云端开始响应的上限（超过就当连不上）、每次最多输出多少 token
#HARO_CLOUD_LLM_TIMEOUT="4s"
#HARO_CLOUD_LLM_MAX_TOKENS="800"
# local：ollama 的地址和模型（用 local 时必须设模型名，例如 qwen3-vl:8b-instruct）
#HARO_OLLAMA_URL="http://127.0.0.1:11434"
#HARO_MODEL=""
# 等本地模型开始回答的上限（卸掉后的第一句要先从磁盘载入，冷启动十几秒）
#HARO_LOCAL_LLM_TIMEOUT="30s"

# 更强的模型（可选；接口与凭证和云端模型相同）：空 = 不分，全部用云端模型
#HARO_STRONG_LLM_MODEL=""
# 用在哪些地方（逗号分隔）：vision = 看画面；correction = 主人纠正时重答；research = 审查后台调查的结论（只核对、提出疑点，不重写）
#HARO_STRONG_LLM_USE="vision,correction,research"
# 看画面时怎么用：expert = 当幕后专家，判断交给云端模型转述；takeover = 带画面的那次请求直接换它回答
#HARO_STRONG_LLM_VISION_MODE="expert"
# 力度、思考写法（默认开着：比关着思考的前台想得深，可以和云端模型是同一个模型）、每次最多输出多少 token（思考也算在里面）
#HARO_STRONG_LLM_EFFORT="medium"
#HARO_STRONG_LLM_THINKING="adaptive"
#HARO_STRONG_LLM_MAX_TOKENS="8000"
#HARO_STRONG_LLM_TIMEOUT="10s"

# ---- 费用：用量账本与上限（用到云端模型时默认货币、月度上限、账本都必填；单价从公共的模型价格目录取）----
# 每笔按原始币种记（服务商按美元收费）；上限和念给主人的金额用默认货币（ISO 4217，例如 JPY），按欧洲央行每天的参考汇率换算
HARO_DEFAULT_CURRENCY="JPY"
# 每月总费用上限（默认货币，大模型 + 搜索）：用到云端模型时必填、要大于 0（没有默认的「不限」）；真想不限就写一个足够大的数。
# 只用本地模型时可以不设
HARO_MONTHLY_CAP="1000"
# 用量账本（SQLite 文件）：上限按它合计，设了月度上限就必须设（只记在内存里时一重启就清零）
HARO_USAGE_DB="data/usage.db"
# 拉到的模型价格目录存在哪（下次拉不到时用）；空 = 不存
#HARO_MODEL_PRICES_CACHE=""
# 参考汇率（欧洲央行每天的那份）和拉到的那份存在哪（下次拉不到时用；空 = 不存，拉不到就起不来）。设了费用上限才用
#HARO_EXCHANGE_RATES_URL="https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml"
#HARO_EXCHANGE_RATES_CACHE=""
# 月度上限到了以后，主人口头确认一次提高多少（默认货币；不设 = 不能口头提高）
#HARO_MONTHLY_RAISE=""
# 后台调查每天的上限（默认货币；不设 = 不限，月度上限照样管着）
#HARO_RESEARCH_DAILY_CAP=""

# ---- 工具 ----
# 内置工具按组开（逗号分隔）：memory（记事与长期记忆）、reminders（提醒）、weather（天气）、search（前台的搜索、读网页）、
# research（后台调查）；不设 = 全开，none = 一个都不要。search、research 还要设搜索的密钥
#HARO_TOOLS=""
# 外部的 MCP 服务（JSON，格式照 Claude Code 的 .mcp.json，另加允许名单 tools、要主人确认的 confirm；见 internal/tools/remote_servers.go）：
# headers 里写 ${环境变量名}，凭证放在环境变量里。不设 = 不接外部服务
#HARO_MCP_SERVERS_FILE=""

# ---- App 的接口（/api/v1/...，契约 api/openapi.yaml）：设了 HARO_APP_PUBLIC_URL 才开 ----
# 登录经 haro 后端代理 akasha（机密客户端），App 不直接调 akasha。地址、凭证都跟部署有关，没有默认值；凭证只放环境变量（K8s Secret）
#HARO_APP_PUBLIC_URL=""
# 网页版的公开根地址（只写 http(s)://主机[:端口]）：放行它跨域调接口、登录完回它的 /auth/callback；空 = 没有网页版
#HARO_APP_WEB_URL=""
#HARO_ACCOUNTS_DB=""
# App 里发的图片存在哪（目录，只有自己能读）；空 = 不收图片
#HARO_ATTACHMENTS_DIR=""
#HARO_OIDC_ISSUER=""
#HARO_OIDC_CLIENT_ID=""
#HARO_OIDC_CLIENT_SECRET=""
# 给登录流程的状态 cookie 签名（至少 32 个字符）
#HARO_OIDC_COOKIE_SECRET=""
# 管理员：akasha 的 sub（第一次登录时日志里有）、原来的声纹名（现有数据按它存）、显示名（空 = 用声纹名）
#HARO_ADMIN_SUBJECT=""
#HARO_ADMIN_PERSON=""
#HARO_ADMIN_NAME=""
#HARO_APP_MIN_VERSION="0.0.0"
# 管理员定月上限时的可选档位（默认货币，逗号分隔）；空 = 没有档位
#HARO_APP_MONTHLY_CAP_OPTIONS=""
# 记忆（记事已并进来）与提醒的存储（SQLite 文件；开着工具时必填）
HARO_NOTES_DB="data/notes.db"
# 长期记忆按意思找：OpenAI 兼容的嵌入接口的根（例如 Text Embeddings Inference 的 http://127.0.0.1:8080/v1）；
# 不设 = 不按意思找（照样能记、列、忘、恢复；查只给最近记的）
#HARO_EMBEDDING_URL=""
# 设了 HARO_EMBEDDING_URL 就必须设模型名（例如 intfloat/multilingual-e5-small）
#HARO_EMBEDDING_MODEL=""
# 云端的嵌入服务才要密钥
#HARO_EMBEDDING_API_KEY=""
# 模型要求的前缀（跟着模型走；e5 系列是问句「query: 」、被检索的内容「passage: 」）；不设 = 不加
#HARO_EMBEDDING_QUERY_PREFIX=""
#HARO_EMBEDDING_DOCUMENT_PREFIX=""
# 联网搜索（Tavily 官方远程 MCP）的密钥：不设 = 不提供联网搜索和后台调查
#HARO_TAVILY_API_KEY=""
# 后台调查的任务账本（SQLite）；空 = 只在内存里
#HARO_RESEARCH_DB=""
# 天气（HARO_TOOLS 里的 weather）：家的位置写「纬度,经度」或 ip（按家里的公网 IP 推定，城市级）；不设 = 查天气时必须说地名
# 告诉模型哪个国家的节假日（ISO 3166-1 两位代码，例如 JP）：今天、明天是节假日时每轮附一行；空 = 不告诉
# 开着 App 的接口时，这几项和 HARO_PROFILE_DIR 只给管理员账号在 App 里没设过的时候用（别的账号在 App 里各设各的）
#HARO_HOLIDAYS=""
#HARO_WEATHER_HOME=""
#HARO_WEATHER_HOME_NAME=""
# Open-Meteo 查不到时的备用：jma（日本气象厅，只覆盖日本）；不设或 none = 不用备用（跟部署的地方有关，没有默认值）
#HARO_WEATHER_BACKUP=""

# ---- 对话、性格、主人资料 ----
# 对话库（SQLite 文件）：对话跟人走；空 = 只在内存里（服务端重启就没了）
#HARO_CONVERSATIONS_DB=""
# 带上最近几轮对话（0 = 不按轮数截，上下文到了下面的门槛才把较早的压成摘要）
#HARO_MAX_HISTORY_TURN="0"
#HARO_CONVERSATION_SUMMARY="true"
# 一轮里请求模型的输入 token 到了这么多就提前压缩较早的几轮（0 = 不看）
#HARO_CONTEXT_COMPACT_TOKENS="80000"
# 一份对话闲了这么久就在后台提前压缩（0 = 不按闲置压缩）
#HARO_CONTEXT_IDLE_COMPACT="1h"
# 性格档案的目录（*.json，例如 assets/personas）；不设 = 不分性格。没记过当前性格时用哪个；记住当前性格的文件
#HARO_PERSONAS_DIR=""
#HARO_PERSONA_DEFAULT="buddy"
#HARO_PERSONA_STATE=""
# 主人资料的目录（household.md + 每人一份 *.md，例子见 assets/profile.example）；空 = 不用。
# 开着 App 的接口时只给管理员账号在 App 里没改过的时候用（改过以后以账号库里的为准）
#HARO_PROFILE_DIR=""
# 追加在前台的基础规则后面的话；代理定义的覆盖目录（同名的 *.md 替换程序里带的那份）
#HARO_SYSTEM_PROMPT=""
#HARO_AGENTS_DIR=""
# 会破坏的操作（删记事等）问了主人之后，多久没确认就作废；不设 = 程序里的默认值（brain.DefaultConfirmationTimeout）
#HARO_CONFIRMATION_TIMEOUT=""
# 单次工具执行最多多久（所有工具共用，包括远程 MCP）；不设 = 程序里的默认值（brain.DefaultToolTimeout）
#HARO_TOOL_TIMEOUT=""
# 多台终端同时听到唤醒词时等多久再选一台（0 = 不仲裁）
#HARO_WAKE_ARBITRATION="300ms"

# ---- 观测 ----
# OTLP/HTTP 的根地址（例如 http://127.0.0.1:4318）；空 = 不导出，只打日志。
# 也认标准的 OTEL_EXPORTER_OTLP_ENDPOINT（设了时以它为准）、OTEL_SERVICE_NAME、OTEL_RESOURCE_ATTRIBUTES（只支持 http/protobuf）
#HARO_OTLP_ENDPOINT=""
