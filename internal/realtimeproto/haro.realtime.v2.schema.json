{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "client.conversation.item.create": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "conversation.item.create"
        },
        "item": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "description": "message"
            },
            "role": {
              "type": "string",
              "description": "user"
            },
            "content": {
              "type": [
                "null",
                "array"
              ],
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "input_text 或 input_image"
                  },
                  "text": {
                    "type": "string"
                  },
                  "image_url": {
                    "type": "string",
                    "description": "input_image：data:image/jpeg;base64,…"
                  }
                },
                "required": [
                  "type"
                ]
              }
            }
          },
          "required": [
            "type",
            "role",
            "content"
          ]
        }
      },
      "required": [
        "type",
        "item"
      ]
    },
    "client.conversation.item.truncate": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "conversation.item.truncate"
        },
        "item_id": {
          "type": "string",
          "description": "haro 不填：截最近一次回答"
        },
        "content_index": {
          "type": "integer"
        },
        "audio_end_ms": {
          "type": "integer",
          "description": "用户听到了回答的前多少毫秒"
        }
      },
      "required": [
        "type",
        "content_index",
        "audio_end_ms"
      ]
    },
    "client.haro.mcp.message": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "haro.mcp.message"
        },
        "message": {
          "type": [
            "null",
            "array"
          ],
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "一条完整的 MCP（JSON-RPC 2.0）消息"
        }
      },
      "required": [
        "type",
        "message"
      ]
    },
    "client.haro.playback.started": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "haro.playback.started"
        }
      },
      "required": [
        "type"
      ]
    },
    "client.haro.playback.stopped": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "haro.playback.stopped"
        }
      },
      "required": [
        "type"
      ]
    },
    "client.haro.terminal.devices": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "haro.terminal.devices"
        },
        "microphone": {
          "type": "string",
          "description": "麦克风的名字；空 = 没有"
        },
        "speaker": {
          "type": "string",
          "description": "音箱的名字；空 = 没有"
        }
      },
      "required": [
        "type",
        "microphone",
        "speaker"
      ]
    },
    "client.haro.wake_word.sleep": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "haro.wake_word.sleep"
        }
      },
      "required": [
        "type"
      ]
    },
    "client.haro.wake_word.wake": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "haro.wake_word.wake"
        }
      },
      "required": [
        "type"
      ]
    },
    "client.input_audio_buffer.append": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "input_audio_buffer.append"
        },
        "audio": {
          "type": "string",
          "description": "base64 编码的 PCM"
        }
      },
      "required": [
        "type",
        "audio"
      ]
    },
    "client.response.cancel": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "response.cancel"
        }
      },
      "required": [
        "type"
      ]
    },
    "client.response.create": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "response.create"
        }
      },
      "required": [
        "type"
      ]
    },
    "client.session.update": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "session.update"
        },
        "session": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "description": "realtime = 对话会话（终端 ↔ 服务端）；transcription = 转写会话（服务端 ↔ haro-asr）"
            },
            "audio": {
              "type": "object",
              "properties": {
                "input": {
                  "type": "object",
                  "properties": {
                    "format": {
                      "type": [
                        "null",
                        "object"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "description": "audio/pcm（16 位有符号小端、单声道）"
                        },
                        "rate": {
                          "type": "integer",
                          "description": "采样率（Hz）"
                        }
                      },
                      "description": "之后 input_audio_buffer.append 的音频格式；送音频之前必须声明",
                      "required": [
                        "type",
                        "rate"
                      ]
                    },
                    "turn_detection": {
                      "type": [
                        "null",
                        "object"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "description": "server_vad 或 semantic_vad"
                        },
                        "eagerness": {
                          "type": "string",
                          "description": "semantic_vad 用：low、medium、high 或 auto"
                        },
                        "threshold": {
                          "type": "number",
                          "description": "语音概率阈值，0–1"
                        },
                        "prefix_padding_ms": {
                          "type": "integer",
                          "description": "识别时带上语音开始前的这段音频（毫秒）"
                        },
                        "silence_duration_ms": {
                          "type": "integer",
                          "description": "静音持续多久算说完（毫秒）"
                        },
                        "create_response": {
                          "type": [
                            "null",
                            "boolean"
                          ],
                          "description": "haro 固定为 false：由终端带上画面后再请求回答"
                        }
                      },
                      "description": "由服务端的 VAD 判断说话开始和结束；null = 这次不改",
                      "required": [
                        "type"
                      ]
                    }
                  },
                  "required": [
                    "turn_detection"
                  ]
                }
              },
              "required": [
                "input"
              ]
            },
            "haro": {
              "type": [
                "null",
                "object"
              ],
              "properties": {
                "wake_word": {
                  "type": [
                    "null",
                    "object"
                  ],
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  },
                  "description": "启用唤醒门：会话从休眠开始，听到唤醒词才处理用户说的话",
                  "required": [
                    "enabled"
                  ]
                }
              },
              "description": "haro 扩展"
            }
          },
          "required": [
            "type",
            "audio"
          ]
        }
      },
      "required": [
        "type",
        "session"
      ]
    },
    "server.conversation.item.input_audio_transcription.completed": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "conversation.item.input_audio_transcription.completed"
        },
        "item_id": {
          "type": "string"
        },
        "transcript": {
          "type": "string"
        },
        "haro": {
          "type": [
            "null",
            "object"
          ],
          "properties": {
            "speaker": {
              "type": "string",
              "description": "认出来的人；没认出来为空"
            },
            "speaker_checked": {
              "type": "boolean"
            }
          },
          "description": "haro 扩展：声纹比对结果；没比对时不带",
          "required": [
            "speaker",
            "speaker_checked"
          ]
        }
      },
      "required": [
        "type",
        "item_id",
        "transcript"
      ]
    },
    "server.error": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "error": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "description": "invalid_request_error 或 server_error"
            },
            "code": {
              "type": "string",
              "description": "稳定的错误码，客户端按它判断"
            },
            "message": {
              "type": "string",
              "description": "给人看的说明；措辞会变，不要拿来判断"
            }
          },
          "required": [
            "type",
            "code",
            "message"
          ]
        }
      },
      "required": [
        "type",
        "error"
      ]
    },
    "server.haro.mcp.message": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "haro.mcp.message"
        },
        "message": {
          "type": [
            "null",
            "array"
          ],
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "一条完整的 MCP（JSON-RPC 2.0）消息"
        }
      },
      "required": [
        "type",
        "message"
      ]
    },
    "server.haro.notice": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "haro.notice"
        },
        "kind": {
          "type": "string",
          "description": "提示的种类，例如 research_done；不认识的种类也照样提示"
        }
      },
      "required": [
        "type",
        "kind"
      ]
    },
    "server.haro.wake_word.detected": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "haro.wake_word.detected"
        },
        "keyword": {
          "type": "string"
        },
        "audio_ms": {
          "type": "integer",
          "description": "唤醒词结束处在会话音频时间轴上的位置（毫秒）"
        },
        "score": {
          "type": "number",
          "description": "唤醒词的声纹分数"
        },
        "level": {
          "type": "number",
          "description": "唤醒词那一段的音量（RMS，0–1）"
        }
      },
      "required": [
        "type",
        "keyword",
        "audio_ms"
      ]
    },
    "server.input_audio_buffer.speech_started": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "input_audio_buffer.speech_started"
        },
        "audio_start_ms": {
          "type": "integer",
          "description": "在会话的音频时间轴上的位置（毫秒）"
        },
        "item_id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "audio_start_ms",
        "item_id"
      ]
    },
    "server.input_audio_buffer.speech_stopped": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "input_audio_buffer.speech_stopped"
        },
        "audio_end_ms": {
          "type": "integer",
          "description": "语音实际结束的位置（毫秒，不含等静音的时间）"
        },
        "item_id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "audio_end_ms",
        "item_id"
      ]
    },
    "server.response.done": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "response.done"
        },
        "response": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "description": "completed、cancelled、incomplete 或 failed"
            },
            "status_details": {
              "type": [
                "null",
                "object"
              ],
              "properties": {
                "reason": {
                  "type": "string",
                  "description": "没有正常完成的原因，例如 unknown_speaker、empty_transcript"
                }
              },
              "required": [
                "reason"
              ]
            },
            "usage": {
              "type": [
                "null",
                "object"
              ],
              "properties": {
                "input_tokens": {
                  "type": "integer"
                },
                "output_tokens": {
                  "type": "integer"
                }
              },
              "required": [
                "input_tokens",
                "output_tokens"
              ]
            }
          },
          "required": [
            "status"
          ]
        }
      },
      "required": [
        "type",
        "response"
      ]
    },
    "server.response.output_audio.delta": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "response.output_audio.delta"
        },
        "delta": {
          "type": "string",
          "description": "base64 编码的 PCM"
        },
        "haro": {
          "type": [
            "null",
            "object"
          ],
          "properties": {
            "format": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "audio/pcm"
                },
                "rate": {
                  "type": "integer"
                },
                "channels": {
                  "type": "integer"
                }
              },
              "required": [
                "type",
                "rate",
                "channels"
              ]
            }
          },
          "description": "haro 扩展：这段音频的格式；不带 = 官方默认的 24 kHz 单声道",
          "required": [
            "format"
          ]
        }
      },
      "required": [
        "type",
        "delta"
      ]
    },
    "server.response.output_audio_transcript.delta": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "response.output_audio_transcript.delta"
        },
        "delta": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "delta"
      ]
    }
  },
  "title": "haro.realtime.v2",
  "description": "haro 的事件：终端 ↔ 服务端的对话会话、服务端 ↔ haro-asr 的转写会话。OpenAI Realtime 正式版的子集加 haro 扩展。",
  "oneOf": [
    {
      "$ref": "#/$defs/client.conversation.item.create"
    },
    {
      "$ref": "#/$defs/client.conversation.item.truncate"
    },
    {
      "$ref": "#/$defs/client.haro.mcp.message"
    },
    {
      "$ref": "#/$defs/client.haro.playback.started"
    },
    {
      "$ref": "#/$defs/client.haro.playback.stopped"
    },
    {
      "$ref": "#/$defs/client.haro.terminal.devices"
    },
    {
      "$ref": "#/$defs/client.haro.wake_word.sleep"
    },
    {
      "$ref": "#/$defs/client.haro.wake_word.wake"
    },
    {
      "$ref": "#/$defs/client.input_audio_buffer.append"
    },
    {
      "$ref": "#/$defs/client.response.cancel"
    },
    {
      "$ref": "#/$defs/client.response.create"
    },
    {
      "$ref": "#/$defs/client.session.update"
    },
    {
      "$ref": "#/$defs/server.conversation.item.input_audio_transcription.completed"
    },
    {
      "$ref": "#/$defs/server.error"
    },
    {
      "$ref": "#/$defs/server.haro.mcp.message"
    },
    {
      "$ref": "#/$defs/server.haro.notice"
    },
    {
      "$ref": "#/$defs/server.haro.wake_word.detected"
    },
    {
      "$ref": "#/$defs/server.input_audio_buffer.speech_started"
    },
    {
      "$ref": "#/$defs/server.input_audio_buffer.speech_stopped"
    },
    {
      "$ref": "#/$defs/server.response.done"
    },
    {
      "$ref": "#/$defs/server.response.output_audio.delta"
    },
    {
      "$ref": "#/$defs/server.response.output_audio_transcript.delta"
    }
  ]
}
